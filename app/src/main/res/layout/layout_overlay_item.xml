<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_overlay_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/overlay_item_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_overlay_icon"
        android:padding="4dp"
        android:src="@drawable/ic_task" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlay_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/overlay_panel_title"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="任务名" />

        <TextView
            android:id="@+id/overlay_item_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/overlay_panel_sub"
            android:textSize="11sp"
            tools:text="任务描述" />
    </LinearLayout>

</LinearLayout>
